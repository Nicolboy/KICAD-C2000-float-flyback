(version 1)

# Exemption clearance pour les pastilles d'un MEME composant (meme motif
# que KICAD-HV, trouve le 2026-10-19 sur U13 : pas de raison electrique
# d'exiger une clearance de routage entre pastilles d'un seul boitier --
# leur ecart est fixe par le pas du boitier, pas par le placement/routage.
# Vecu ici sur U18 (VSSOP-8, pas 0,65mm) : 0,15mm reel entre broches
# adjacentes contre 0,2mm exige par la netclasse PRI.
(rule "pastilles_meme_composant"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent")
  (constraint clearance (min 0mm)))

# Distance haute tension, HT-02 (IPC-9592B, formule convertisseurs,
# 0,1+0,01*V) a 100V -- marge au-dessus des 90V reels du secondaire
# elevable (regles-pcb/06-haute-tension.md).
#
# Cote A : les nets qui portent reellement la haute tension -- PAS toute
# la netclasse SEC (corrige le 2026-10-29, 2e passe : A.hasNetclass('SEC')
# couvrait aussi du petit signal du meme domaine flottant et rendait le
# routage impossible). Chaque net ci-dessous verifie par tracage du
# circuit, pas suppose par le nom :
#   V_HT_OUT, HV_BIAS, HV80_IN, VOUT_P, VOUT_N -- sorties/bus principaux.
#   HV_BIAS_OUT -- PAS la meme chose que HV_BIAS_IN malgre le nom : piloté
#     activement par la boucle de linearisation (Q7/MCP6001) et couple a
#     VOUT_P/VOUT_N par le pont 2x100kOhm (R9/R10) qui fait monter le
#     secondaire -- atteint reellement ~90V. Son seul lien GND (C59,
#     decouplage HF) ne l'empeche pas de monter en continu. A tort exclu
#     entierement lors de la 3e passe (2026-10-29) avant tracage complet.
#
# Cote B : !hasNetclass('SEC') (toute la classe, pas une liste de noms)
# -- evite de comparer les nets A a leurs propres voisins du meme domaine
# flottant. Netclasse SEC completee au passage (nets verifies par
# tracage, pas par le nom) dans KICAD-HT.kicad_pro :
#   V_HT_OUT (oubli, meme defaut que Temp_ht en #26).
#   Net-(U22-INP)/Net-(U22-INN) -- U22 (AMC0302R) a sa broche GND1
#     (cote 1) sur VOUT_N litteralement : ses entrees differentielles
#     sont bien dans le meme domaine flottant.
#   ISNS_P -- R40 relie ISNS_P a Net-(U22-INP) (ci-dessus), meme reseau
#     de mesure, meme domaine.
# HV_BIAS_IN (J1) verifie et PAS ajoute : decouple vers GND reel (C62,
#   J1 broche 2 = GND directement) -- entree brute avant regulation,
#   domaine different de HV_BIAS_OUT malgre le nom proche.
#
# Externe uniquement (F.Cu/B.Cu) : en interne, le plancher projet
# 0,2mm du net_settings par defaut couvre deja HT-02 (0,2mm en
# interne). Exclu meme composant pour les pastilles (meme motif que
# pastilles_meme_composant -- A.Parent != B.Parent). Exclu aussi, par
# nom explicite (pas de condition generique trouvee pour pastille-vs-
# zone-de-l'autre-broche-du-meme-composant, une zone n'a pas de Parent
# de footprint) :
#   T1 (transformateur MSD1514, 4 broches VIN/SW_PRI/SW_SEC/VOUT_P).
#   R9 (HV_BIAS_OUT/VOUT_P) et R10 (HV_BIAS_OUT/VOUT_N) -- le pont
#     2x100kOhm lui-meme, meme logique.
#   R54 (HV_BIAS_OUT/Net-(Q7-S)) -- la resistance de la boucle de
#     linearisation elle-meme, meme logique.
# A refaire a la main si un autre composant rencontre le meme probleme.
(rule "HT_distance_90V"
  (condition "(A.NetName == 'V_HT_OUT' || A.NetName == 'HV_BIAS' || A.NetName == 'HV80_IN' || A.NetName == 'VOUT_P' || A.NetName == 'VOUT_N' || A.NetName == 'HV_BIAS_OUT') && !B.hasNetclass('SEC') && A.Parent != B.Parent && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu') && !((A.Reference == 'T1' || B.Reference == 'T1') && (A.NetName == 'VIN' || A.NetName == 'SW_PRI' || A.NetName == 'SW_SEC' || A.NetName == 'VOUT_P') && (B.NetName == 'VIN' || B.NetName == 'SW_PRI' || B.NetName == 'SW_SEC' || B.NetName == 'VOUT_P')) && !((A.Reference == 'R9' || B.Reference == 'R9') && (A.NetName == 'HV_BIAS_OUT' || A.NetName == 'VOUT_P') && (B.NetName == 'HV_BIAS_OUT' || B.NetName == 'VOUT_P')) && !((A.Reference == 'R10' || B.Reference == 'R10') && (A.NetName == 'HV_BIAS_OUT' || A.NetName == 'VOUT_N') && (B.NetName == 'HV_BIAS_OUT' || B.NetName == 'VOUT_N')) && !((A.Reference == 'R54' || B.Reference == 'R54') && (A.NetName == 'HV_BIAS_OUT' || A.NetName == 'Net-(Q7-S)') && (B.NetName == 'HV_BIAS_OUT' || B.NetName == 'Net-(Q7-S)'))")
  (constraint clearance (min 1.1mm)))

(rule "barriere_controle"
  (condition "A.hasNetclass('CTRL') && !B.hasNetclass('CTRL') && A.Reference != B.Reference && B.Pin_Type != 'no_connect'")
  (constraint clearance (min 4mm)))

# barriere_primaire_secondaire retiree le 2026-10-25 : le secondaire
# (VOUT_N/VOUT_P, classe SEC) ne sera plus flottant/isole du primaire
# dans le montage final -- decision utilisateur, contredit la premisse
# du plan doc/plan-isolation-4couches.md et du README (secondaire
# flottant). Seule la barriere controle<->{primaire,secondaire} reste
# reelle. La classe SEC est conservee pour organisation/documentation,
# sans contrainte de barriere avec PRI.
